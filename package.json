{
  "name": "@jujulego/vite-plugin-swc",
  "version": "1.2.1",
  "license": "MIT",
  "author": "Julien Capellari <julien.capellari@gmail.com>",
  "repository": "github:Jujulego/vite-plugin-swc",
  "description": "A simple plugin to use swc with Vite",
  "keywords": [
    "vite-plugin",
    "swc"
  ],
  "sideEffects": false,
  "files": [
    "./dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "scripts": {
    "lint": "eslint .",
    "clean": "shx rm -r dist",
    "build": "jill run 'build:esm // build:types'",
    "build:esm": "swc src -d dist --strip-leading-paths",
    "build:types": "tsc --project tsconfig.build.json",
    "test": "vitest run --typecheck",
    "test:types": "tsc --project tests"
  },
  "peerDependencies": {
    "@swc/core": "^1.3.0"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jujulego/jill": "3.0.11",
    "@microsoft/eslint-formatter-sarif": "3.1.0",
    "@rollup/plugin-swc": "0.4.0",
    "@swc/cli": "0.8.0",
    "@swc/core": "1.15.11",
    "@types/node": "24.12.2",
    "@typescript-eslint/utils": "8.58.1",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/eslint-plugin": "1.6.15",
    "eslint": "10.2.0",
    "jiti": "2.6.1",
    "rollup": "4.60.1",
    "shx": "0.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.1",
    "vite": "7.3.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "3.2.4"
  },
  "packageManager": "yarn@4.12.0"
}
